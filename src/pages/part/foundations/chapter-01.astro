const description =
  "ডাটা কী, Data Analytics কীভাবে ব্যবসা ও প্রযুক্তিতে ব্যবহৃত হয় এবং কেন এটি গুরুত্বপূর্ণ।";

const objectives = [
  "Data-এর মৌলিক ধারণা ব্যাখ্যা করতে পারা",
  "বাস্তব জীবনের Data-এর উদাহরণ শনাক্ত করা",
  "Data Analytics-এর প্রাথমিক ধারণা বোঝা",
  "Business Problem থেকে Analysis Question তৈরি করা",
