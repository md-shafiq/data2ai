<script>
  const quiz = document.querySelector("#chapter-quiz");

  if (quiz) {
    const submitButton = quiz.querySelector("#submit-quiz");
    const result = quiz.querySelector("#quiz-result");

    const answers = [1, 0, 2, 0, 1];

    submitButton?.addEventListener("click", () => {
      let score = 0;

      quiz.querySelectorAll(".quiz-question").forEach((question, index) => {
        const selected = question.querySelector('input[type="radio"]:checked');
        const feedback = question.querySelector(".quiz-feedback");

        if (!feedback) return;

        const correct = selected && Number(selected.value) === answers[index];

        if (correct) score++;

        feedback.hidden = false;
        feedback.textContent = correct
          ? "Correct! " + [
              "Data হলো পর্যবেক্ষণ, পরিমাপ বা রেকর্ড করা তথ্য।",
              "একাধিক Order Record নিয়ে Order Dataset তৈরি হয়।",
              "কী সমস্যা সমাধান করতে হবে তা আগে নির্ধারণ করতে হয়।",
              "Customer behavior বিশ্লেষণ Data Analytics-এর বাস্তব ব্যবহার।",
              "Profit হিসাব করতে Cost বিবেচনা করা হয়।",
            ][index]
          : "Incorrect. সঠিক উত্তর: " + question.querySelectorAll(".quiz-option span")[answers[index]].textContent;
      });

      if (result) {
        result.textContent = `Your Score: ${score} / ${answers.length}`;
      }
    });
  }

  const assignment = document.querySelector("#chapter-assignment");

  if (assignment) {
    const checkboxes = assignment.querySelectorAll('input[type="checkbox"]');
    const progressText = assignment.querySelector("#progress-text");
    const progressFill = assignment.querySelector("#progress-fill");

    const updateProgress = () => {
      const completed = [...checkboxes].filter((item) => item.checked).length;
      const percentage = Math.round((completed / checkboxes.length) * 100);

      if (progressText) progressText.textContent = `${percentage}%`;
      if (progressFill) progressFill.style.width = `${percentage}%`;
    };

    checkboxes.forEach((checkbox) => {
      checkbox.addEventListener("change", updateProgress);
    });

    const copyButton = assignment.querySelector("#copy-assignment");
    const copyStatus = assignment.querySelector("#copy-status");

    copyButton?.addEventListener("click", async () => {
      const checklist = [...assignment.querySelectorAll(".assignment-item")]
        .map((item) => {
          const checkbox = item.querySelector("input");
          return `${checkbox?.checked ? "[x]" : "[ ]"} ${item.textContent?.trim()}`;
        })
        .join("\n");

      try {
        await navigator.clipboard.writeText(
          "My First Data Analytics Report\n\n" + checklist
        );

        if (copyStatus) copyStatus.textContent = "Checklist copied!";
      } catch {
        if (copyStatus) copyStatus.textContent = "Copy unavailable. Please copy manually.";
      }
    });
  }
</script>