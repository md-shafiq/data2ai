const assignments = [
  "Data কী, নিজের ভাষায় ব্যাখ্যা করুন।",
  "Data-এর বাস্তব জীবনের ১০টি উদাহরণ লিখুন।",
  "একটি ছোট E-commerce Dataset তৈরি করুন।",
  "প্রতিটি Order-এর Sales Calculation করুন।",
  "Total Sales এবং Average Order Value বের করুন।",
